
#include <stdio.h>

#define MAX 100

int heap[MAX];
int size = 0;

void insert(int value) {
    if (size >= MAX) {
        printf("Heap is full!\n");
        return;
    }

    int i = size;
    heap[i] = value;
    size++;

    // Move the element upward
    while (i > 0 && heap[(i - 1) / 2] < heap[i]) {
        int temp = heap[i];
        heap[i] = heap[(i - 1) / 2];
        heap[(i - 1) / 2] = temp;

        i = (i - 1) / 2;
    }
}

void display() {
    if (size == 0) {
        printf("Heap is empty!\n");
        return;
    }

    printf("Max Heap: ");
    for (int i = 0; i < size; i++) {
        printf("%d ", heap[i]);
    }
    printf("\n");
}

int main() {
    int n, value;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n < 0 || n > MAX) {
        printf("Invalid number of elements!\n");
        return 1;
    }

    for (int i = 0; i < n; i++) {
        printf("Enter element %d: ", i + 1);
        scanf("%d", &value);
        insert(value);
    }

    display();

    return 0;
}
