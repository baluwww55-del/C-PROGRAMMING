
#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, i;
    int *ptr;

    // Allocate memory using malloc
    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Invalid size!\n");
        return 1;
    }

    ptr = (int *)malloc(n * sizeof(int));

    if (ptr == NULL) {
        printf("Memory allocation failed!\n");
        return 1;
    }

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++) {
        scanf("%d", &ptr[i]);
    }

    printf("Elements are: ");

    for (i = 0; i < n; i++) {
        printf("%d ", ptr[i]);
    }

    // Resize memory using realloc
    int newSize;

    printf("\nEnter new size: ");
    scanf("%d", &newSize);

    if (newSize <= 0) {
        printf("Invalid size!\n");
        free(ptr);
        return 1;
    }

    int *temp = realloc(ptr, newSize * sizeof(int));

    if (temp == NULL) {
        printf("Memory reallocation failed!\n");
        free(ptr);
        return 1;
    }

    ptr = temp;

    printf("Enter additional elements:\n");

    for (i = n; i < newSize; i++) {
        scanf("%d", &ptr[i]);
    }

    printf("Updated array: ");

    for (i = 0; i < newSize; i++) {
        printf("%d ", ptr[i]);
    }

    // Release allocated memory
    free(ptr);
    ptr = NULL;

    printf("\nMemory released successfully!\n");

    return 0;
}
